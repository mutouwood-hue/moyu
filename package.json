{
  "name": "wanongfei-pc",
  "version": "1.3.0",
  "description": "挣点窝囊费 · Win/macOS 工资罐与摸鱼统计悬浮工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check state-store.js && node --check engine.js && node --check jar-coins.js && node --check main-render.js && node --check float-render.js && node --check game/muyu.js && node --check game/defense-core.js && node --check game/defense.js",
    "test": "node --test",
    "dist": "npm run dist:win && npm run dist:mac",
    "dist:win": "node scripts/build-windows.cjs",
    "dist:mac": "electron-builder --mac dmg zip --x64 --arm64"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "resedit": "^2.0.3"
  },
  "build": {
    "appId": "com.wanongfei.app",
    "productName": "挣点窝囊费",
    "copyright": "© 2026 窝囊费工作室",
    "directories": {
      "output": "rel_24"
    },
    "afterPack": "./afterPack.js",
    "files": [
      "main.js",
      "state-store.js",
      "engine.js",
      "jar-coins.js",
      "float-render.js",
      "styles.css",
      "v1a.css",
      "floating.css",
      "v1a-floating.css",
      "index.html",
      "floating.html",
      "main-render.js",
      "game/**",
      "package.json",
      "assets/**"
    ],
    "win": {
      "icon": "assets/wnf-icon.ico",
      "target": "nsis",
      "artifactName": "挣点窝囊费-v${version}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/app-icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "挣点窝囊费-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "挣点窝囊费",
      "installerIcon": "assets/wnf-icon.ico",
      "uninstallerIcon": "assets/wnf-icon.ico"
    }
  },
  "dependencies": {
    "matter-js": "^0.20.0"
  }
}
